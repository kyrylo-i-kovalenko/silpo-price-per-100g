{
  "manifest_version": 3,
  "name": "Silpo Price Calculator",
  "version": "4.0.0",
  "description": "Ціна за 100 г, 100 мл або 1 шт і підсвітка найвигідніших товарів на silpo.ua",
  "permissions": [],
  "content_scripts": [
    {
      "matches": ["https://silpo.ua/*"],
      "js": ["src/core.js", "src/content.js"],
      "css": ["src/styles.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
